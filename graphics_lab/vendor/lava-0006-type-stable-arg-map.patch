-    converted_args = map(a -> Adapt.adapt(adaptor, a), args)
+    converted_args = map_args(a -> Adapt.adapt(adaptor, a), args)
 
     # Kernel ABI: kernel signature types are POST-adapt (LavaDeviceArray, not Ptr{T}).

# Luxel — the engine. Source only.
#
# Fetched and built content (scanned models, terrain layers, kits, backdrops)
# lands in the ignored artifacts/ tree from pinned manifests in tools/. The
# only committed art is small source art under assets/ and docs/media/.

# Machine-local MCP server config (absolute paths)
.mcp.json

# Rust build output (workspace and per-crate invocations)
**/target/
world_core/crates/*/Cargo.lock

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Julia lockfiles are canonical build inputs and must remain visible to source
# control. Caches and generated reports remain excluded below.

# Isolated research scratch (raw clones, binaries, logs). Curated reports
# live under docs/research/.
research/

# Generated reports, bundles, caches, and local orchestration state
artifacts/
asset_intake_reports/

# Offline character_lab pages from build.py: they inline modules and source
# art (several MiB each). Rebuild with python3 character_lab/build.py.
character_lab/assembly.html
character_lab/index.html
character_lab/reference.html
character_lab/review.html
character_lab/topology.html
character_lab/workbench-fragment.html
.freebuff/
kvfold/
.pytest_cache/

# Cubism Editor import PSDs are regenerated from layered PNGs by
# character_lab/cyan_source_author.py and exceed the 5 MiB commit limit.
*.psd

# Generated kit output. The generators in pipeline/ are the source; the meshes
# they emit are not, and they land wherever the caller points them.
*.glb
!world_core/crates/asset_contract/tests/fixtures/
!world_core/crates/asset_contract/tests/fixtures/*.glb
*.gltf
*.fbx
*.blend
*.blend1

.DS_Store
*.log

# Generated repository graph; source and reports remain in the tree.
graphify-out/
graphics_lab/TetLab.zip

# TetCage primary source: 15 MB, fetched from the URL pinned (with SHA-256)
# in graphics_lab/tet-lab/references/tetcage-paper-pin.md.
graphics_lab/tet-lab/references/*.pdf
# Its text extraction is AMD's paper too and must not be published; regenerate
# locally with pdftotext -layout.
graphics_lab/tet-lab/references/paper.txt

# Local agent handoffs and operator state.
/.local/
